linters: lintr::linters_with_defaults(
    # Google R style: lines of at most 80 characters; functions in
    # BigCamelCase, variables in snake_case, constants as kConstant;
    # explicit return()
    line_length_linter = lintr::line_length_linter(80L),
    object_name_linter = lintr::object_name_linter(
      c("snake_case", "CamelCase", "camelCase")),
    return_linter = lintr::return_linter(return_style = "explicit"),
    # Off: ggplot2 aesthetics name data columns, e.g. aes(PC1, PC2), which
    # this linter would report as undefined variables
    object_usage_linter = NULL
  )
